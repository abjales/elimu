# Database
DATABASE_URL=postgresql://elimu:your_password@localhost:5432/elimu

# Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Pro tier pricing
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=

# M-Pesa (Safaricom Daraja) — server-side only, NEVER exposed to the client
# Environment: 'sandbox' or 'production'
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
# 'till' (Buy Goods) or 'paybill'
MPESA_SHORTCODE_TYPE=paybill
# Public HTTPS URL Safaricom will POST the payment callback to
MPESA_CALLBACK_URL=
# Pro prices in KES (must match NEXT_PUBLIC_* display values)
MPESA_PRO_MONTHLY_AMOUNT_KSHS=2100
MPESA_PRO_ANNUAL_AMOUNT_KSHS=7500
MPESA_PRO_LIFETIME_AMOUNT_KSHS=15000

# OpenMAIC (AI Classroom Engine)
OPENMAIC_URL=http://localhost:3001
OPENMAIC_INTERNAL_URL=http://localhost:3001

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Pro price display (client-side); must match MPESA_PRO_*_AMOUNT_KSHS server values
NEXT_PUBLIC_MPESA_PRO_MONTHLY_AMOUNT_KSHS=2100
NEXT_PUBLIC_MPESA_PRO_ANNUAL_AMOUNT_KSHS=7500
NEXT_PUBLIC_MPESA_PRO_LIFETIME_AMOUNT_KSHS=15000
